#!/usr/bin/env python3
"""Project-only model entrypoint. No unsandboxed fallback or auth copies."""
import argparse
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'scripts'))
from notation_sandbox import build, exec_sandbox, validate_writes

ROLES = {'sol': 'sol-implementer', 'deepseek': 'deepseek-implementer',
         'challenger': 'glm-reviewer', 'security': 'glm-security-reviewer'}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('role', choices=['advisor', *ROLES])
    parser.add_argument('--write', action='append', default=[], metavar='REPO_PATH')
    parser.add_argument('--read-only', action='store_true')
    parser.add_argument('prompt', nargs='?')
    args = parser.parse_args()
    reviewer = args.role in ('challenger', 'security')
    if args.role != 'advisor' and not args.prompt:
        parser.error('a bounded task/review packet is required')
    if (reviewer or args.read_only or args.role == 'advisor') and args.write:
        parser.error('write-set is only valid for implementers')
    if args.role in ('sol', 'deepseek') and not (args.write or args.read_only):
        parser.error('declare --write paths or --read-only; no implicit repository writes')
    validate_writes(ROOT, args.write)
    if args.write:
        subprocess.run([str(ROOT / 'scripts/notation-task'), 'check'], cwd=ROOT, check=True)
    inline = json.loads(os.environ.get('OPENCODE_CONFIG_CONTENT', '{}'))
    if not (inline.get('provider', {}).get('opencodex') or
            inline.get('providers', {}).get('opencodex')):
        if os.environ.get('NOTATION_LAUNCH_ARGS'):
            raise RuntimeError('OpenCodex did not inject a provider; refusing to run')
        proxy = shutil.which('opencodex')
        if not proxy:
            raise RuntimeError('OpenCodex required; no direct/unsandboxed fallback')
        env = dict(os.environ, PATH=f"{ROOT / 'scripts/sandbox-bin'}:{os.environ['PATH']}",
                   NOTATION_LAUNCH_ARGS=json.dumps(sys.argv[1:]))
        os.execve(proxy, [proxy, 'opencode'], env)
    # Provider catalog/auth is the only inherited OpenCode configuration. Host
    # agents, plugins, permissions and MCP servers cannot override project rules.
    providers = {key: inline[key] for key in ('provider', 'providers') if key in inline}
    inline = json.loads((ROOT / 'opencode.json').read_text())
    inline.update(providers)
    if reviewer or args.read_only:
        inline.setdefault('mcp', {})['serena'] = {'enabled': False}
    env = {'OPENCODE_CONFIG_CONTENT': json.dumps(inline)}
    if args.role == 'advisor':
        env['GH_TOKEN'] = subprocess.check_output(['gh', 'auth', 'token'], text=True).strip()
        if not env['GH_TOKEN']:
            raise RuntimeError('GitHub authentication unavailable')
        command = ['/usr/bin/codex', '--cd', '/work', '--model', 'gpt-6-astra',
                   '-c', 'model_reasoning_effort="high"', '--sandbox', 'danger-full-access',
                   '--ask-for-approval', 'never']
        if args.prompt:
            command.append(args.prompt)
    else:
        models = {'sol': 'opencodex/gpt-6.1-sol#high',
                  'deepseek': 'opencodex/combo/deepseek-auto#high',
                  'challenger': 'opencodex/zai/glm-5.3-flash#high',
                  'security': 'opencodex/zai/glm-5.3-flash#high'}
        command = ['/usr/bin/opencode', 'run', '--standalone', '--agent', ROLES[args.role],
                   '--model', models[args.role], args.prompt]
    argv = build(ROOT, args.role, command, env, args.write)
    exec_sandbox(argv)


if __name__ == '__main__':
    try:
        main()
    except (ValueError, RuntimeError, subprocess.CalledProcessError) as error:
        sys.exit(f'Notation launcher refused: {error}')
