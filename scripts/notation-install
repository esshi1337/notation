#!/usr/bin/env python3
"""Update only the app directory mounted for the advisor; never execute artifacts."""
import argparse
import fcntl
import os
from pathlib import Path
import shutil
import stat
import tempfile

INSTALL = Path('/opt/notation-install')


def image_open(path):
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    stream = os.fdopen(fd, 'rb')
    if not stat.S_ISREG(os.fstat(fd).st_mode):
        stream.close()
        raise ValueError('AppImage must be a regular file')
    header = stream.read(11)
    if header[:4] != b'\x7fELF' or header[8:11] != b'AI\x02':
        stream.close()
        raise ValueError('Expected a type-2 ELF AppImage')
    stream.seek(0)
    return stream


def stage(source, directory, prefix='.notation-stage-'):
    with image_open(source) as stream:
        before = os.fstat(stream.fileno())
        fd, name = tempfile.mkstemp(prefix=prefix, dir=directory)
        try:
            with os.fdopen(fd, 'wb') as output:
                shutil.copyfileobj(stream, output)
                after = os.fstat(stream.fileno())
                if (before.st_size, before.st_mtime_ns, before.st_ctime_ns) != (after.st_size, after.st_mtime_ns, after.st_ctime_ns) or output.tell() != before.st_size:
                    raise ValueError('AppImage changed while copying')
                os.fchmod(output.fileno(), 0o755)
                output.flush()
                os.fsync(output.fileno())
            return Path(name)
        except BaseException:
            os.unlink(name)
            raise


def update(directory, source=None, rollback=False):
    directory = Path(directory).absolute()
    if not directory.is_dir() or any(p.is_symlink() for p in [directory, *directory.parents]):
        raise ValueError('Installation directory is absent or contains symlinks')
    lockfd = os.open(directory / '.update.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    staged = []
    try:
        fcntl.flock(lockfd, fcntl.LOCK_EX)
        # Reserved staging names are safe to remove while holding the shared lock.
        if any(directory.glob('.notation-recovery-*')):
            raise ValueError('A recovery image needs manual inspection before another update')
        for stale in directory.glob('.notation-stage-*'):
            if stale.is_file() or stale.is_symlink():
                stale.unlink()
        live = directory / 'Notation.AppImage'
        previous = directory / 'Notation.AppImage.previous'
        for path in (live, previous):
            if path.is_symlink() or (path.exists() and not path.is_file()):
                raise ValueError('Installation targets must be regular files')
        candidate = stage(previous if rollback else source, directory)
        staged.append(candidate)
        backup = None
        if live.exists():
            backup = stage(live, directory, prefix='.notation-recovery-')
            staged.append(backup)
        os.replace(candidate, live)
        if backup is not None:
            try:
                os.replace(backup, previous)
            except OSError:
                try:
                    os.replace(backup, live)
                except OSError:
                    # Preserve recovery material if even restoration is refused.
                    staged.remove(backup)
                    raise RuntimeError(f'Could not restore live app; recovery image: {backup}')
                raise
        dirfd = os.open(directory, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(dirfd)
        finally:
            os.close(dirfd)
    finally:
        for path in staged:
            path.unlink(missing_ok=True)
        os.close(lockfd)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest='action', required=True)
    sub.add_parser('install').add_argument('artifact', type=Path)
    sub.add_parser('rollback')
    args = parser.parse_args()
    update(INSTALL, getattr(args, 'artifact', None), args.action == 'rollback')
    print('Notation updated. The change takes effect on the next app launch.')


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, RuntimeError) as error:
        raise SystemExit(f'Installation refused: {error}')
