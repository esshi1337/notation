{
  "name": "notation",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "desktop": "tauri dev --features desktop",
    "desktop:build": "python3 scripts/native-cli.py build --features desktop",
    "desktop:install": "python3 scripts/install-desktop.py",
    "test:e2e": "playwright test",
    "test:store": "node tests/store-recovery.mjs",
    "test:preferences": "node tests/preferences-shortcuts.mjs",
    "test:documents": "node --experimental-strip-types tests/document-features.mjs",
    "test:markdown": "node tests/markdown-features.mjs",
    "test:tables": "node tests/tables-folding.mjs",
    "predev": "node scripts/prepare-pdf-assets.mjs",
    "prebuild": "node scripts/prepare-pdf-assets.mjs",
    "test:export": "node tests/export-html.mjs",
    "test:canvas": "node --experimental-strip-types tests/canvas-templates.mjs",
    "test:workspace": "node tests/workspace-features.mjs",
    "desktop:engines": "python3 scripts/bundle-engines.py",
    "test:citations": "node tests/citations.mjs",
    "desktop:bundle": "python3 scripts/native-cli.py bundle --features desktop --bundles appimage",
    "test:hemingway": "node --experimental-strip-types tests/hemingway.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/language": "^6.11.3",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.4",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@viz-js/viz": "^3.31.0",
    "diff": "^9.0.0",
    "dompurify": "^3.2.7",
    "katex": "^0.19.0",
    "marked": "^16.3.0",
    "mermaid": "^11.12.0",
    "pdfjs-dist": "^6.4.299",
    "svelte": "^5.39.6",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tauri-apps/cli": "^2.8.4",
    "@types/katex": "^0.16.8",
    "svelte-check": "^4.3.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  }
}
