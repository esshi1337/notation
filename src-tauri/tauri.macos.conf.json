{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Notation",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "theme": "Dark",
        "backgroundColor": "#000000",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 16
        }
      }
    ]
  }
}
