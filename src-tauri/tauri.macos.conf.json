{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown Document",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "mmd"
        ],
        "name": "Mermaid Diagram",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "canvas"
        ],
        "name": "Canvas",
        "role": "Editor",
        "rank": "Alternate"
      }
    ]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Notation",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "theme": "Dark",
        "backgroundColor": "#000000",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 16
        }
      }
    ]
  }
}
